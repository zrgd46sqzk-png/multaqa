# Supabase — create a project at https://supabase.com, then Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser. Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (UAE checkout) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Stripe webhook signing secret — https://dashboard.stripe.com/webhooks (endpoint: /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=

# InstaPay (Egypt) — the handle/number shown to buyers at checkout, e.g. your registered mobile number
NEXT_PUBLIC_INSTAPAY_HANDLE=

# Deployed site URL — used to build absolute URLs (Open Graph tags, sitemap.xml)
NEXT_PUBLIC_SITE_URL=

# WhatsApp contact number shown in the footer, digits only with country code, e.g. 971501234567. Leave blank to hide the link entirely.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics/ad pixels — each is entirely optional; leaving one blank just means
# that script never loads (see src/components/Analytics.tsx)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
